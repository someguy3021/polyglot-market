{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "declaration": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": [
    "src/index.ts",
    "src/generated/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
