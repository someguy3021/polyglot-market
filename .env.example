# Polyglot Market — корневое окружение (локальная демо-среда).
# Секреты здесь НЕ настоящие: это локальный стек по умолчанию (см. ADR-001/008).

# PostgreSQL (контейнер infra)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=polyglot
DB_USERNAME=polyglot
DB_PASSWORD=secret

# MinIO (S3-совместимое хранилище, контейнер infra)
S3_ENDPOINT=http://127.0.0.1:9002
S3_BUCKET=products
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Медиа
MAX_UPLOAD_MB=5

# JWT — общий для обоих бекендов (один и тот же токен должен читаться обоими)
JWT_SECRET=change-me-local-dev-secret

# Docker в WSL (только Windows-хост): имя дистрибутива
# PM_WSL_DISTRO=Ubuntu-24.04
