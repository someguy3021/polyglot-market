{
  "name": "polyglot-market",
  "version": "0.1.0",
  "private": true,
  "description": "One API contract — 2 backends — 7 frontends. Marketplace megarepo showcase.",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:reset": "node scripts/infra.mjs reset",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:reset": "node scripts/db.mjs reset",
    "generate:clients": "node scripts/generate-clients.mjs",
    "spec:lint": "pnpm --dir packages/conformance run lint:spec",
    "conformance": "pnpm --dir packages/conformance test",
    "start": "tsx scripts/panel/manager.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "extract": "node scripts/extract-stack.mjs",
    "serve-backend": "node scripts/serve-backend.mjs",
    "docker:up": "node scripts/combo.mjs",
    "docker:down": "node scripts/combo-down.mjs",
    "k8s:up": "node scripts/k8s.mjs up",
    "k8s:down": "node scripts/k8s.mjs down",
    "k8s:status": "node scripts/k8s.mjs status",
    "check:all": "node scripts/check-all.mjs",
    "e2e:matrix": "node scripts/e2e-matrix.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "bcryptjs": "^3.0.2",
    "eslint": "^9.0.0",
    "pg": "^8.13.0",
    "s3rver": "^3.7.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
