APP_NAME="Polyglot Market (Laravel)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Общий Postgres из infra (ADR-001). Миграции НЕ через artisan — ADR-002.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=polyglot
DB_USERNAME=polyglot
DB_PASSWORD=secret

# JWT — тот же секрет, что у NestJS (один и тот же токен читают оба бекенда).
# HS256 требует >= 32 байт.
JWT_SECRET=dev-only-secret-change-me-0123456789-abcdef-secret-change-me
JWT_TTL=1440

# Сессии/кэш в памяти: API без состояния
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# CORS: origins фронтов (через запятую)
CORS_ORIGINS=http://localhost:9000,http://localhost:9001,http://localhost:4200,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# S3-хранилище (MinIO из infra / dev-fallback, ADR-008)
S3_ENDPOINT=http://127.0.0.1:9002
S3_BUCKET=products
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
