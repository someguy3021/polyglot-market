{
  "name": "showcase/laravel-backend",
  "type": "project",
  "description": "Polyglot Market — Laravel-реализация единого контракта. Схему БД не создаёт (общие SQL-миграции, ADR-002).",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-pdo_pgsql": "*",
    "intervention/image": "^3.0",
    "laravel/framework": "^12.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "php-open-source-saver/jwt-auth": "^2.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi || true"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
